{
  "manifest_version": 3,
  "name": "SmartScreen Claude 用量同步",
  "version": "1.0.1",
  "description": "將目前 Claude 用量頁的額度同步至本機 SmartScreen。",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "nativeMessaging",
    "scripting",
    "storage"
